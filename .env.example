# Copiá este archivo a `.env` y completá sólo la plataforma que vayas a usar.
# `.env` está en .gitignore: los tokens nunca se commitean.

# ─── Shopify ────────────────────────────────────────────────────────────────
# Panel → Configuración → Apps y canales de venta → Desarrollar apps →
# Crear una app → Configuración de Admin API → scopes:
#   write_products, read_products, write_inventory, read_inventory, read_locations
# Después "Instalar app" y copiar el Admin API access token (empieza con shpat_).
# El token se muestra UNA sola vez.
SHOPIFY_SHOP=mi-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional. Por defecto usa la versión estable actual de la Admin API.
# SHOPIFY_API_VERSION=2026-07

# ─── Tiendanube / Nuvemshop ─────────────────────────────────────────────────
# Panel → Mi cuenta → Aplicaciones → Aplicaciones a medida → Crear aplicación.
# Marcá los permisos de "Productos" (lectura y escritura) y luego autorizá la
# app: ahí te da el access token y el store_id (el `user_id` del OAuth).
TIENDANUBE_STORE_ID=1234567
TIENDANUBE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obligatorio: la API rechaza o limita las peticiones sin un User-Agent
# identificable. Poné el nombre de tu tienda y un email de contacto real.
TIENDANUBE_USER_AGENT=Noctu (tu-email@ejemplo.com)
